      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "intense" },
        "plant.family": { "eq": "succulent" }
      },
      "effects": {
        "lightScore": -0.3,
        "pestRiskScore": -0.1
      },
      "weight": 0.5,
      "explanation": "Succulents thrive in intense light; thick cuticles prevent photodamage and pest pressure"
    },
    {
      "id": "light_succulent_shade_stress",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "shade" },
        "plant.family": { "eq": "succulent" }
      },
      "effects": {
        "lightScore": 0.4,
        "pestRiskScore": 0.2
