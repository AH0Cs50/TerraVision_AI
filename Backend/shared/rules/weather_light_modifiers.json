{
  "factor": "weather",
  "layer": "light_modifiers",
  "rules": [
    {
      "id": "light_general_shade",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "shade" }
      },
      "effects": {
        "lightScore": -0.3,
        "lightMultiplier": 0.7
      },
      "weight": 0.6,
      "explanation": "Deep shade drastically reduces photosynthetically active radiation, lowering light demand satisfaction"
    },
    {
      "id": "light_general_indirect",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "indirect" }
      },
      "effects": {
        "lightScore": -0.1
      },
      "weight": 0.3,
      "explanation": "Indirect light provides moderate illumination suitable for understory plants"
    },
    {
      "id": "light_general_partial",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "partial" }
      },
      "effects": {
        "lightScore": 0.1
      },
      "weight": 0.2,
      "explanation": "Partial sun provides balanced light levels for most plant types"
    },
    {
      "id": "light_general_full_sun",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "full_sun" }
      },
      "effects": {
        "lightScore": 0.3
      },
      "weight": 0.3,
      "explanation": "Full sun exposure maximizes photosynthetic potential for sun-adapted plants"
    },
    {
      "id": "light_general_intense",
      "factor": "weather",
      "condition": {
        "weather.light": { "eq": "intense" }
      },
      "effects": {
        "lightScore": 0.4,
        "lightMultiplier": 1.3
      },
      "weight": 0.5,
      "explanation": "Intense direct sunlight can cause photoinhibition and heat stress in sensitive plants"
    },
    {
